# PostgreSQL connection string. STRONGLY RECOMMENDED in production:
# without it the bot falls back to local JSON files, which on a host with an
# ephemeral filesystem (e.g. Render's free tier) means every profile, like and
# payment record is wiped on each deploy or restart. On the first boot with
# this set, any existing JSON data is imported automatically.
DATABASE_URL=

TELEGRAM_BOT_TOKEN=
# Optional: verifies incoming webhook requests actually came from Telegram.
# Leave blank for local long-polling (no public domain needed).
TELEGRAM_WEBHOOK_SECRET=
# Only needed if not running on Render (which sets RENDER_EXTERNAL_URL itself).
WEBHOOK_DOMAIN=
PORT=3000

# Click Merchant API (src/click.js) -- Premium subscription + per-profile
# unlock payments. Without CLICK_MERCHANT_ID/CLICK_SERVICE_ID, checkout
# buttons fall back to a "not configured yet" message instead of a real
# Click payment page.
CLICK_SECRET_KEY=
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=

# Payme (Paycom) Merchant API (src/payme.js) -- the second payment provider.
# Both Click and Payme settle the SAME orders, so a feature bought with
# either is granted identically. Leave blank to launch with Click only: the
# Payme button is then simply not offered, and its callbacks are refused.
#
# PAYME_MERCHANT_ID  the cash-box id from your Payme merchant cabinet
# PAYME_KEY          the merchant key Payme issues (used as the HTTP Basic
#                    password on callbacks -- treat it like a password)
# PAYME_ACCOUNT_FIELD  which key inside params.account carries our order id.
#                    Payme fixes this per merchant when the cash-box is set
#                    up and it is NOT always "order_id" -- check what your
#                    cabinet says and set it here if it differs.
#
# Callback URL to give Payme: https://<your-domain>/payme
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_ACCOUNT_FIELD=order_id

# Optional second bot (src/adminBot.js) -- runs in this same process so it
# shares the same data/ files. Only needed if you want the admin panel.
ADMIN_BOT_TOKEN=
# Optional: verifies incoming admin-webhook requests actually came from
# Telegram, same idea as TELEGRAM_WEBHOOK_SECRET above. If left blank while
# ADMIN_BOT_TOKEN is set, the app auto-generates a random one at startup
# instead of running unauthenticated -- set this explicitly to silence that
# startup warning.
ADMIN_WEBHOOK_SECRET=
# The PIN required to log into the admin panel (src/adminBot.js). REQUIRED --
# set this to a private value. If left blank, the app falls back to an old
# default PIN that is readable by anyone with access to this repository's
# source code, and logs a warning every time it does.
ADMIN_PIN_CODE=

# Your own Telegram numeric user id (src/alerts.js) -- get it from
# @userinfobot. Without it, a crash or a failed broadcast is invisible until
# someone thinks to check /health or a user complains. You must have sent
# /start to the bot that will deliver these (the admin bot if ADMIN_BOT_TOKEN
# is set, otherwise the main bot) at least once, or Telegram refuses to let a
# bot message a chat it was never started from.
ALERT_CHAT_ID=

# Anthropic API key (src/aiAssistant.js) -- powers the "🤖 AI yordamchi"
# button in the admin panel, which answers free-form questions about the
# bot's real stats (registrations, sales, complaints). Without it, that
# button tells the admin the feature isn't configured instead of failing.
ANTHROPIC_API_KEY=
