TELEGRAM_BOT_TOKEN=
# Optional: verifies incoming webhook requests actually came from Telegram.
# Leave blank for local long-polling (no public domain needed).
TELEGRAM_WEBHOOK_SECRET=
# Only needed if not running on Render (which sets RENDER_EXTERNAL_URL itself).
WEBHOOK_DOMAIN=
PORT=3000

# Click Merchant API (src/click.js) -- Premium subscription + per-profile
# unlock payments. Without CLICK_MERCHANT_ID/CLICK_SERVICE_ID, checkout
# buttons fall back to a "not configured yet" message instead of a real
# Click payment page.
CLICK_SECRET_KEY=
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=

# Optional second bot (src/adminBot.js) -- runs in this same process so it
# shares the same data/ files. Only needed if you want the admin panel.
ADMIN_BOT_TOKEN=
# Optional: verifies incoming admin-webhook requests actually came from
# Telegram, same idea as TELEGRAM_WEBHOOK_SECRET above. Strongly recommended
# if ADMIN_BOT_TOKEN is set -- without it, the admin webhook route accepts
# unauthenticated requests.
ADMIN_WEBHOOK_SECRET=
