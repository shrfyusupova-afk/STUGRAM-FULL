# Get this from @BotFather. This is a SEPARATE bot from ForOne -- its own
# token, its own @username.
BOT_TOKEN=

# Only needed if not running on Render (which sets RENDER_EXTERNAL_URL itself).
WEBHOOK_DOMAIN=

PORT=3000

# Auto-generated at startup if left blank -- set it explicitly so it survives
# a restart, otherwise Telegram briefly retries against the old value.
WEBHOOK_SECRET=

# Longest video (in seconds) the bot will attempt. A long download ties up
# the single instance for everyone else waiting behind it. Default: 900 (15
# minutes).
MAX_DURATION_SECONDS=900

# Telegram bots cannot upload a file over ~50 MB through the regular Bot API.
# Kept a little under that limit on purpose. Default: 49.
MAX_UPLOAD_MB=49
